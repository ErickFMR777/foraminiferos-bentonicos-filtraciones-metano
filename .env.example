# Plantilla. Los valores reales viven en las variables de entorno de Vercel
# (Settings -> Environment Variables) y en .env.local, que NO se versiona.
# Para traerlos a local:  vercel env pull .env.local

# Secreto con el que se firma la cookie de sesión (HMAC-SHA256).
# SIN ÉL EL SITIO QUEDA ABIERTO: así el desarrollo local no pide contraseña,
# y por eso mismo no debe faltar en producción.
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESION_SECRETO=

# Almacén Vercel Blob privado donde vive la contraseña (su derivación PBKDF2,
# nunca la contraseña en claro). Lo inyecta Vercel al vincular el almacén; el
# token alcanza SÓLO a ese almacén, no a la cuenta.
BLOB_READ_WRITE_TOKEN=

# Credenciales de ARRANQUE. Sólo se usan la primera vez, para sembrar el
# almacén cuando aún está vacío. A partir de ahí manda el almacén y estas dos
# se ignoran: la contraseña se cambia desde el propio dashboard.
#
# Son también la vía de recuperación si se olvida la contraseña: al borrar el
# blob `auth/credenciales.json`, el almacén vuelve a sembrarse desde aquí.
DASHBOARD_USUARIO=
DASHBOARD_CLAVE=

# Respuesta a la pregunta de seguridad. SEGUNDA BARRERA, y sólo para CAMBIAR
# la contraseña: es lo que permite enseñarle el dashboard a alguien —dándole
# la contraseña— sin que pueda cambiarla y dejar fuera al autor.
#
# Se compara tal cual, distinguiendo mayúsculas de minúsculas (sólo se
# recortan los espacios de los extremos). Se guarda derivada, nunca en claro.
# Si no está definida, cambiar la contraseña queda BLOQUEADO: ante un fallo de
# configuración la barrera se cierra, no se abre.
#
# Para cambiarla: actualizar esta variable y borrar del blob los campos
# `respuestaSalt` y `respuestaHash`, que se vuelven a sembrar desde aquí.
DASHBOARD_RESPUESTA=
